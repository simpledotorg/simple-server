#!/bin/zsh
# Daily run for the QI reports page, one country at a time: ./run_daily.sh bangladesh
# Copy to run_daily.sh next to publish_district_reports.py and schedule it (macOS launchd or cron for
# the prototype; a server job in production). Builds the reports listed in countries/<country>.json
# (Titration from Metabase, Statins from its CSV) and publishes them to that country's app.
COUNTRY="${1:-bangladesh}"
cd "$(dirname "$0")"
source "./settings.${COUNTRY}.sh"   # exports MB_URL and MB_KEY for that country (see settings.sh.example)

# Local Docker prototype only: where the app reads reports from. In production, replace
# publish_to_dashboard() in the script with an upload to that country's shared storage instead.
export QI_REPORTS_DIR="$HOME/simple-server/storage/qi_reports"
export QI_COMPOSE_FILE="$HOME/simple-server/.docker/docker-compose.yml"
export PATH="/usr/local/bin:/opt/homebrew/bin:/Applications/Docker.app/Contents/Resources/bin:$PATH"

echo "=== $(date) ($COUNTRY) ===" >> run.log
python3 publish_district_reports.py --country "$COUNTRY" >> run.log 2>&1
