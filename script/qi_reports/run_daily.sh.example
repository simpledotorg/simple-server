#!/bin/zsh
# Daily run for the QI reports page. Copy to run_daily.sh next to publish_district_reports.py,
# and schedule it (macOS launchd or cron for the prototype; a server job in production).
# Builds Titration (from Metabase) and Statins (from statins.csv) PDFs and publishes them.
cd "$(dirname "$0")"
source ./settings.sh   # exports MB_URL and MB_KEY (see settings.sh.example)

# Local Docker prototype only: where the app reads reports from. In production, replace
# publish_to_dashboard() in the script with an upload to the server's shared storage instead.
export QI_REPORTS_DIR="$HOME/simple-server/storage/qi_reports"
export QI_COMPOSE_FILE="$HOME/simple-server/.docker/docker-compose.yml"
export PATH="/usr/local/bin:/opt/homebrew/bin:/Applications/Docker.app/Contents/Resources/bin:$PATH"

echo "=== $(date) ===" >> run.log
python3 publish_district_reports.py >> run.log 2>&1
