<% content_for :title do %>
  <%= @region.name %> | <%= @form_type[:title] %> | <%= @response[:label] %>
<% end %>

<%= render "reports/regions/header", period_selector: false %>

<%= render "back_link",
      url: reports_region_form_responses_path(
        report_scope: params[:report_scope],
        id: @region.slug,
        form_type: @form_type[:id]
      ),
      label: @form_type[:title] %>

<div class="card col-md-7" style="text-align: left">
  <div class="modal-header">
    <h2 class="modal-title"><%= @form_type[:title] %></h2>
  </div>
  <%= bootstrap_form_with(
        url: reports_region_form_path(
          report_scope: params[:report_scope],
          id: @region.slug,
          form_type: @form_type[:id],
          response_id: @response[:id]
        ),
        method: :patch,
        local: true,
        autocomplete: "off",
        label_errors: true,
        id: "form_report_#{@response[:id]}"
      ) do |form| %>

    <div class="modal-body">
      <div class="form-group">
        <label>Facility:</label>
        <span><%= @region.name %></span>
      </div>

      <div class="form-group">
        <label>For end of month:</label>
        <span><%= @response[:label] %></span>
      </div>

      <% @form_sections.each do |section| %>
        <h3 class="pt-4"><%= section[:header] %></h3>
        <% section[:fields].each do |field| %>
          <% if field[:type] == :text %>
            <%= form.text_area field[:label].parameterize.underscore,
                  label: field[:label],
                  value: field[:value],
                  rows: 3 %>
          <% elsif field[:type] == :radio %>
            <%= form.form_group field[:label].parameterize.underscore, label: {text: field[:label]} do %>
              <% field[:options].each do |option| %>
                <%= form.radio_button field[:label].parameterize.underscore, option,
                      label: option.capitalize,
                      checked: field[:value] == option %>
              <% end %>
            <% end %>
          <% else %>
            <%= form.number_field field[:label].parameterize.underscore,
                  label: field[:label],
                  value: field[:value],
                  min: 0 %>
          <% end %>
        <% end %>
      <% end %>
    </div>

    <div class="modal-footer">
      <%= form.primary "Save Report", class: "btn btn-primary btn-block" %>
    </div>
  <% end %>
</div>
