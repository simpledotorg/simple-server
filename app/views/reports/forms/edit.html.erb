<% content_for :title do %>
  <%= @region.name %> | <%= @form_type[:title] %> | <%= @response[:label] %>
<% end %>

<%= render "reports/regions/header", period_selector: false %>

<%= render "back_link",
      url: reports_region_form_responses_path(
        report_scope: params[:report_scope],
        id: @region.slug,
        form_type: @form_type[:id]
      ) %>

<div class="card col-md-7" style="text-align: left">
  <div class="modal-header">
    <h2 class="modal-title"><%= @form_type[:title] %></h2>
  </div>
  <%= bootstrap_form_with(
        url: reports_region_form_path(
          report_scope: params[:report_scope],
          id: @region.slug,
          form_type: @form_type[:id],
          response_id: @response[:id]
        ),
        method: :patch,
        local: true,
        autocomplete: "off",
        label_errors: true,
        id: "form_report_#{@response[:id]}"
      ) do |form| %>

    <div class="modal-body">
      <div class="form-group">
        <label>Facility:</label>
        <span><%= @region.name %></span>
      </div>

      <div class="form-group">
        <label>For end of month:</label>
        <span><%= @response[:label] %></span>
      </div>

      <% if @form_layout %>
        <% @form_layout["item"].each do |layout_item| %>
          <%= render "layout_item", layout_item: layout_item, form: form %>
        <% end %>
      <% else %>
        <%= render "form_sections", form: form, form_sections: @form_sections %>
      <% end %>
    </div>

    <div class="modal-footer">
      <%= form.primary "Save Report", class: "btn btn-primary btn-block" %>
    </div>
  <% end %>
</div>
