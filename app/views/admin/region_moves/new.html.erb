<div class="page-header">
  <h1 class="page-title">Move Region</h1>
  <p class="page-description">
    Move regions in the administrative hierarchy (facilities, blocks, districts, etc.)
  </p>
</div>

<div class="card">
  <div class="card-body">
    <%= form_with url: preview_admin_region_moves_path, method: :post, local: true do |f| %>

      <div class="alert alert-info">
        <i class="fas fa-info-circle mr-2"></i>
        <strong>How it works:</strong>
        <ul class="mb-0 mt-2">
          <li>Move a <strong>facility</strong> to a different <strong>block</strong></li>
          <li>Move a <strong>block/woreda</strong> to a different <strong>district/zone</strong></li>
          <li>Move a <strong>district/zone</strong> to a different <strong>state/region</strong></li>
        </ul>
      </div>

      <div class="form-group">
        <%= f.label :region_identifier, "Select Region to Move" %>
        <%= f.select :region_identifier,
          options_for_select(@all_regions.map { |r|
            ["#{r.name} (#{r.region_type})", r.slug]
          }),
          { prompt: "Search and select region..." },
          class: "form-control select2",
          required: true %>
        <small class="form-text text-muted">
          <i class="fas fa-search"></i>
          Select the facility, block, or district you want to move
        </small>
      </div>

      <div class="form-group">
        <%= f.label :new_parent_identifier, "Select New Parent Region" %>
        <%= f.select :new_parent_identifier,
          options_for_select(@all_regions.map { |r|
            ["#{r.name} (#{r.region_type})", r.slug]
          }),
          { prompt: "Search and select parent..." },
          class: "form-control select2",
          required: true %>
        <small class="form-text text-muted">
          <i class="fas fa-sitemap"></i>
          Select where to move it (must be correct parent type)
        </small>
      </div>

      <div class="alert alert-warning">
        <i class="fas fa-exclamation-triangle mr-2"></i>
        <strong>Warning:</strong> Moving a region will also move all its descendants.
        For example, moving a block will move all facilities within it.
      </div>

      <div class="form-group">
        <%= f.submit "Preview Move", class: "btn btn-primary" %>
        <%= link_to "Cancel", root_path, class: "btn btn-outline-secondary" %>
      </div>

    <% end %>
  </div>
</div>

<div class="card mt-4">
  <div class="card-header bg-light">
    <h5 class="mb-0"><i class="fas fa-book mr-2"></i>Hierarchy Rules</h5>
  </div>
  <div class="card-body">
    <div class="row">
      <div class="col-md-6">
        <h6 class="text-success"><i class="fas fa-check-circle"></i> Valid Moves</h6>
        <ul>
          <li><strong>Facility</strong> → Block</li>
          <li><strong>Block</strong> → District</li>
          <li><strong>District</strong> → State</li>
          <li><strong>State</strong> → Organization</li>
        </ul>
      </div>
      <div class="col-md-6">
        <h6 class="text-danger"><i class="fas fa-times-circle"></i> Invalid Moves</h6>
        <ul>
          <li><strong>Block</strong> → Block (same level)</li>
          <li><strong>Facility</strong> → Facility (same level)</li>
          <li><strong>District</strong> → District (same level)</li>
        </ul>
      </div>
    </div>
  </div>
</div>

<% if @all_regions.any? %>
  <script>
    // Initialize Select2 for better search/filtering
    $(document).ready(function() {
      $('.select2').select2({
        placeholder: function() {
          return $(this).data('placeholder');
        },
        allowClear: true,
        width: '100%'
      });
    });
  </script>
<% end %>
