<div class="page-header">
  <h1 class="page-title">Move Region</h1>
  <p class="page-description">
    Move facilities, blocks, or districts to different parent regions
  </p>
</div>

<div class="card">
  <div class="card-body">
    <%= form_with url: preview_admin_region_moves_path, method: :post, local: true, id: "region-move-form" do |f| %>

      <div class="row">
        <!-- LEFT SIDE: Origin (What to move) -->
        <div class="col-md-6">
          <div class="move-section">
            <h5 class="section-title">
              <i class="fas fa-map-marker-alt mr-2"></i>Origin - What to move?
            </h5>

            <!-- State Selection for Origin -->
            <div class="form-group">
              <label>Select State/Region</label>
              <select class="form-control select2" id="origin-state" required>
                <option value="">Choose state...</option>
                <% Region.where(region_type: 'state').order(:name).each do |state| %>
                  <option value="<%= state.slug %>"><%= state.name %></option>
                <% end %>
              </select>
            </div>

            <!-- District Selection for Origin -->
            <div class="form-group">
              <label>Select District/Zone</label>
              <select class="form-control select2" id="origin-district" disabled required>
                <option value="">Choose district...</option>
              </select>
            </div>

            <!-- Block/Facility Selection for Origin -->
            <div class="form-group">
              <label>Select Block/Woreda or Facility</label>
              <%= f.select :region_identifier,
                [],
                { prompt: "Choose region to move..." },
                class: "form-control select2",
                id: "origin-region",
                disabled: true,
                required: true %>
              <small class="form-text text-muted">
                <i class="fas fa-info-circle"></i>
                Select the specific facility or block you want to move
              </small>
            </div>
          </div>
        </div>

        <!-- RIGHT SIDE: Destination (Where to move) -->
        <div class="col-md-6">
          <div class="move-section destination-section">
            <h5 class="section-title">
              <i class="fas fa-map-pin mr-2"></i>Destination - Where to move it?
            </h5>

            <!-- State Selection for Destination -->
            <div class="form-group">
              <label>Select State/Region</label>
              <select class="form-control select2" id="dest-state" required>
                <option value="">Choose state...</option>
                <% Region.where(region_type: 'state').order(:name).each do |state| %>
                  <option value="<%= state.slug %>"><%= state.name %></option>
                <% end %>
              </select>
            </div>

            <!-- District Selection for Destination -->
            <div class="form-group">
              <label>Select District/Zone</label>
              <select class="form-control select2" id="dest-district" disabled required>
                <option value="">Choose district...</option>
              </select>
            </div>

            <!-- Block Selection for Destination -->
            <div class="form-group">
              <label>Select Block/Woreda</label>
              <%= f.select :new_parent_identifier,
                [],
                { prompt: "Choose destination..." },
                class: "form-control select2",
                id: "dest-region",
                disabled: true,
                required: true %>
              <small class="form-text text-muted">
                <i class="fas fa-sitemap"></i>
                Select where you want to move it to
              </small>
            </div>
          </div>
        </div>
      </div>

      <div class="alert alert-warning mt-4">
        <i class="fas fa-exclamation-triangle mr-2"></i>
        <strong>Note:</strong> Moving a region will also move all its descendants.
        For example, moving a block will move all facilities within it.
      </div>

      <div class="form-group mt-4">
        <%= f.submit "Preview Move", class: "btn btn-primary btn-lg", id: "preview-button", disabled: true %>
        <%= link_to "Cancel", root_path, class: "btn btn-outline-secondary btn-lg" %>
      </div>

    <% end %>
  </div>
</div>

<style>
  .move-section {
    background: #f8f9fa;
    padding: 20px;
    border-radius: 8px;
    border: 2px solid #dee2e6;
    min-height: 400px;
  }

  .destination-section {
    background: #e8f4f8;
    border-color: #0084c7;
  }

  .section-title {
    margin-bottom: 20px;
    padding-bottom: 10px;
    border-bottom: 2px solid #dee2e6;
    color: #495057;
    font-weight: 600;
  }

  .destination-section .section-title {
    color: #0066a1;
  }

  .form-group label {
    font-weight: 500;
    color: #495057;
    margin-bottom: 8px;
  }

  .select2-container {
    font-size: 14px;
  }

  .select2-container--default .select2-selection--single {
    height: 40px;
    border: 1px solid #ced4da;
    border-radius: 4px;
  }

  .select2-container--default .select2-selection--single .select2-selection__rendered {
    line-height: 38px;
  }

  .select2-container--default .select2-selection--single .select2-selection__arrow {
    height: 38px;
  }
</style>

<script>
$(document).ready(function() {
  // Initialize Select2 on all dropdowns
  $('.select2').select2({
    allowClear: true,
    width: '100%'
  });

  // Region data grouped by parent
  const regionsByParent = <%= raw @regions_by_parent.to_json %>;

  // Track selected origin region type
  let selectedOriginType = null;

  // ORIGIN: State changes → load districts
  $('#origin-state').on('change', function() {
    const stateSlug = $(this).val();
    const districtDropdown = $('#origin-district');
    const regionDropdown = $('#origin-region');

    // Reset downstream dropdowns
    districtDropdown.prop('disabled', true).html('<option value="">Choose district...</option>').trigger('change');
    regionDropdown.prop('disabled', true).html('<option value="">Choose region to move...</option>').trigger('change');
    $('#preview-button').prop('disabled', true);

    if (stateSlug) {
      // Load districts for this state
      const districts = regionsByParent[stateSlug] || [];
      districts.forEach(district => {
        districtDropdown.append(new Option(district.name, district.slug));
      });
      districtDropdown.prop('disabled', false);
    }
  });

  // ORIGIN: District changes → load blocks/facilities
  $('#origin-district').on('change', function() {
    const districtSlug = $(this).val();
    const regionDropdown = $('#origin-region');

    // Reset region dropdown
    regionDropdown.html('<option value="">Choose region to move...</option>');
    regionDropdown.prop('disabled', true).trigger('change');
    $('#preview-button').prop('disabled', true);

    if (districtSlug) {
      // Load blocks and facilities for this district
      const regions = regionsByParent[districtSlug] || [];
      const blocks = regions.filter(r => r.region_type === 'block');
      const facilities = regions.filter(r => r.region_type === 'facility');

      // Add blocks
      if (blocks.length > 0) {
        const blockGroup = $('<optgroup label="Blocks/Woredas">');
        blocks.forEach(block => {
          blockGroup.append(new Option(block.name, block.slug));
        });
        regionDropdown.append(blockGroup);
      }

      // Add facilities
      if (facilities.length > 0) {
        const facilityGroup = $('<optgroup label="Facilities">');
        facilities.forEach(facility => {
          facilityGroup.append(new Option(facility.name, facility.slug));
        });
        regionDropdown.append(facilityGroup);
      }

      regionDropdown.prop('disabled', false);
    }
  });

  // ORIGIN: Region selected → filter destination options
  $('#origin-region').on('change', function() {
    const selectedSlug = $(this).val();

    if (selectedSlug) {
      // Find the selected region's type
      const allRegions = <%= raw @all_regions.to_json %>;
      const selectedRegion = allRegions.find(r => r.slug === selectedSlug);
      selectedOriginType = selectedRegion ? selectedRegion.region_type : null;

      // Enable destination state dropdown
      $('#dest-state').prop('disabled', false);
      checkFormComplete();
    } else {
      selectedOriginType = null;
      $('#preview-button').prop('disabled', true);
    }
  });

  // DESTINATION: State changes → load districts
  $('#dest-state').on('change', function() {
    const stateSlug = $(this).val();
    const districtDropdown = $('#dest-district');
    const regionDropdown = $('#dest-region');

    // Reset downstream dropdowns
    districtDropdown.prop('disabled', true).html('<option value="">Choose district...</option>').trigger('change');
    regionDropdown.prop('disabled', true).html('<option value="">Choose destination...</option>').trigger('change');
    $('#preview-button').prop('disabled', true);

    if (stateSlug) {
      // Load districts for this state
      const districts = regionsByParent[stateSlug] || [];
      districts.forEach(district => {
        districtDropdown.append(new Option(district.name, district.slug));
      });
      districtDropdown.prop('disabled', false);
    }
  });

  // DESTINATION: District changes → load blocks (filtered by origin type)
  $('#dest-district').on('change', function() {
    const districtSlug = $(this).val();
    const regionDropdown = $('#dest-region');

    // Reset region dropdown
    regionDropdown.html('<option value="">Choose destination...</option>');
    regionDropdown.prop('disabled', true).trigger('change');
    $('#preview-button').prop('disabled', true);

    if (districtSlug && selectedOriginType) {
      // Determine valid parent type based on origin
      let validParentType = null;
      if (selectedOriginType === 'facility') validParentType = 'block';
      else if (selectedOriginType === 'block') validParentType = 'district';
      else if (selectedOriginType === 'district') validParentType = 'state';

      // Load regions filtered by valid parent type
      const regions = regionsByParent[districtSlug] || [];
      const validRegions = validParentType === 'block'
        ? regions.filter(r => r.region_type === 'block')
        : validParentType === 'district'
          ? [{ name: $('#dest-district option:selected').text(), slug: districtSlug, region_type: 'district' }]
          : regions;

      validRegions.forEach(region => {
        // Don't include the same region that's being moved
        if (region.slug !== $('#origin-region').val()) {
          regionDropdown.append(new Option(region.name, region.slug));
        }
      });

      regionDropdown.prop('disabled', false);
    }
  });

  // DESTINATION: Region selected → check if form complete
  $('#dest-region').on('change', function() {
    checkFormComplete();
  });

  function checkFormComplete() {
    const originSelected = $('#origin-region').val();
    const destSelected = $('#dest-region').val();

    if (originSelected && destSelected) {
      $('#preview-button').prop('disabled', false);
    } else {
      $('#preview-button').prop('disabled', true);
    }
  }
});
</script>
