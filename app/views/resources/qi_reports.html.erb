<h1 class="page-header">
  QI reports
</h1>
<div id="resources">
  <div>
    <div class="row">
      <div class="col-lg-2 pl-lg-0">
        <nav class="secondary-nav">
          <h4 class="pl-2 mt-3">
            Reports
          </h4>
          <% @qi_reports.each do |name| %>
            <%= link_to name, resources_qi_reports_path(file: name),
                  class: "nav-link #{"active" if name == @selected_report}" %>
          <% end %>
          <%= link_to "← Back to resources", resources_path, class: "nav-link" %>
        </nav>
      </div>
      <div class="col-12 col-lg-10">
        <% if @qi_reports.empty? %>
          <div class="card">
            <h2>
              QI reports
            </h2>
            <p>No QI reports are available yet.</p>
          </div>
        <% else %>
          <% report_path = "/documents/qi_reports/#{ERB::Util.url_encode(@selected_report)}" %>
          <div class="card" id="card-qi-report">
            <h2>
              <%= @selected_report %>
            </h2>
            <div class="resource-link resource-doc">
              <a href="<%= report_path %>" download>
                <i class="far fa-file-pdf"></i> Download PDF
              </a>
              <span>
                Save this report to your computer.
              </span>
            </div>
            <div class="resource-link resource-doc">
              <a href="#" id="qi-report-print">
                <i class="far fa-print"></i> Print
              </a>
              <span>
                Print this report.
              </span>
            </div>
            <iframe id="qi-report-frame" src="<%= report_path %>" title="<%= @selected_report %>"
                    class="mt-3" style="width: 100%; height: 80vh; border: 1px solid #eee;"></iframe>
          </div>
          <script>
            document.getElementById("qi-report-print").addEventListener("click", function (event) {
              event.preventDefault();
              var frame = document.getElementById("qi-report-frame");
              try {
                frame.contentWindow.focus();
                frame.contentWindow.print();
              } catch (e) {
                window.open(frame.src, "_blank");
              }
            });
          </script>
        <% end %>
      </div>
    </div>
  </div>
</div>
